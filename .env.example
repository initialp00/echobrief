# ---- EchoBrief environment ----
# Copy to .env and fill in your key:  cp .env.example .env

# Required for a live demo: OpenRouter API key.
# Used by the worker for:
#   1) speech-to-text on audio briefs (OPENROUTER_STT_MODEL)
#   2) structuring transcripts into incident notes (OPENROUTER_MODEL)
# Transcript-only ingest can still run without a key (offline structurer fallback),
# but audio ingest will fail without a real key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Postgres connection (asyncpg driver). Host "postgres" is the docker-compose service name.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/echobrief

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRANSCRIBE=echobrief.transcribe
KAFKA_TOPIC_STRUCTURE=echobrief.structure
KAFKA_CONSUMER_GROUP=echobrief-workers

# OpenRouter endpoints (same key for both)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Structures transcript → incident note JSON
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Speech-to-text for audio_url / audio_file (swap to any OpenRouter STT model)
# Discover models: https://openrouter.ai/collections/speech-to-text-models
OPENROUTER_STT_MODEL=openai/whisper-1

# Host port for the Nginx entry point (the whole app: UI + /api + /docs).
# Default is 80; override if that port is taken, e.g. WEB_PORT=8090.
WEB_PORT=80
