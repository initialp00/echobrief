# ---- EchoBrief environment ----
# Copy to .env and fill in your key:  cp .env.example .env

# Required: OpenRouter API key (used by the worker to structure notes via claude-sonnet).
# If left blank / set to the placeholder, the worker falls back to a deterministic
# offline structurer so the full pipeline still runs end-to-end without network access.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Postgres connection (asyncpg driver). Host "postgres" is the docker-compose service name.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/echobrief

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRANSCRIBE=echobrief.transcribe
KAFKA_TOPIC_STRUCTURE=echobrief.structure
KAFKA_CONSUMER_GROUP=echobrief-workers

# LLM config (OpenRouter, OpenAI-compatible endpoint)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
